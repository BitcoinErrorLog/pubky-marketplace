# Pubky Marketplace install verification: one file per environment.
# Copy to a private location (not the repository), fill in, then:
#   node .cursor/skills/marketplace-install-verify/scripts/verify.mjs --config <file> --out <dir>
# Environment variables with the same name override values in this file. Put secrets (database
# URLs, registry tokens) in the environment, never here; commands below may reference them as $VAR.

# ---- Required ----------------------------------------------------------------------------
MIV_ENV=staging                       # staging | production (production refuses --deep)
SHOP_ORIGINS=https://staging.shop.example   # every origin the Shop is served from, comma separated
SERVICE_URL=https://api.staging.shop.example
PAYKIT_URL=https://paykit.staging.shop.example
LOCKS_URL=https://locks.staging.shop.example
NEXUS_URL=https://nexus.staging.shop.example
# FIAT_VERIFIER_URL=https://fiat.staging.shop.example   # only if the fiat gateway is deployed

# Further config files merged under this one (for example generated facts), comma separated.
# MIV_INCLUDE=facts.env

# ---- Source pins (version parity and migration checks) ------------------------------------
# owner/repo@<commit, tag or branch>; a 40-character commit is best.
# SHOP_SOURCE=pubky/pubky-marketplace@<sha>
# SERVICE_SOURCE=pubky/pubky-marketplace-service@<sha>
# PAYKIT_SOURCE=pubky/paykit-server@<sha>
# LOCKS_SOURCE=pubky/locks@<sha>
# NEXUS_SOURCE=pubky/marketplace-nexus@<sha>
# FIAT_SOURCE=pubky/pubky-fiat-verifier@<sha>
# <SVC>_BUILD_SOURCE overrides the version check when a wrapper repo builds the image.

# Commands that print the commit each running build was made from (last word of stdout).
# The Nexus reports its own commit over HTTP; the other services do not.
# On a VM with Docker:
#   SERVICE_RUNNING_COMMIT_CMD=ssh api-vm docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' marketplace-service
# From a registry image (public, or private with REGISTRY_BASIC=oauth2accesstoken:$(gcloud auth print-access-token)):
#   PAYKIT_RUNNING_COMMIT_CMD=node .cursor/skills/marketplace-install-verify/scripts/running-commit.mjs image <registry>/<name>@sha256:<digest>

# ---- Expectations (each check is skipped when its key is unset) ---------------------------
# EXPECT_LOCK_SERVER_KEY=pubky…        # the carried-over Lock Server identity
# EXPECT_HOMESERVER=<z32>              # Shop runtime homeserver
# EXPECT_SHOP_DEPLOY_ENV=staging
# EXPECT_SHOP_TESTNET=false
# EXPECT_BITCOIN_NETWORK=regtest       # bitcoin | regtest | testnet | signet
# EXPECT_BITCOIN_OFFER=true            # service /health paykit_rail.bitcoin_offer_available
# EXPECT_MIN_LISTINGS=1
# REFERENCE_NEXUS_URL=https://old-nexus.example   # parity of /v0/stream/listings
# FORBIDDEN_HOSTS=old-host-1.example,old-host-2.example   # retired hosts that must not appear
# TLS_MIN_DAYS=21
# NEXUS_MAX_SNAPSHOT_AGE_MIN=30

# ---- Config facts (non-secret) -------------------------------------------------------------
# The rendered config files; only named non-secret keys are read from them.
# PAYKIT_CONFIG_FILE=/etc/paykit/paykit-server.toml
# LOCKS_CONFIG_FILE=/etc/locks/config.toml
# Or the values directly:
# PAYKIT_TRUSTED_LOCKS_KEY=pubky…
# PAYKIT_SETUP_ALLOWED_ORIGINS=https://staging.shop.example
# PAYKIT_BITCOIN_NETWORK=regtest
# LOCKS_PAYKIT_SERVER_URL=http://paykit.internal:3001
# LOCKS_ALLOWED_RETURN_ORIGINS=https://staging.shop.example
# LOCKS_RUNTIME_ENVIRONMENT=staging
# From the marketplace service's environment:
# SERVICE_PAYKIT_SERVER_URL=http://paykit.internal:3001
# SERVICE_LOCKS_SERVER_URL=http://locks.internal:3000
# SERVICE_ALLOWED_ORIGINS=https://staging.shop.example
# SERVICE_SANDBOX_PAYMENTS_ENABLED=false
# From the fiat verifier's environment:
# FIAT_PAYKIT_SERVER_URL=, FIAT_TRUSTED_LOCKS_KEY=, FIAT_BUYER_RETURN_ORIGINS=
# Private addresses the services use for each other (accepted besides the public URLs):
# SERVICE_PAYKIT_EXPECTED_URL=http://paykit.internal:3001
# SERVICE_LOCKS_EXPECTED_URL=http://locks.internal:3000
# LOCKS_PAYKIT_EXPECTED_URL=http://paykit.internal:3001
# FIAT_PAYKIT_EXPECTED_URL=http://paykit.internal:3001
# Commands run inside the caller's network to prove a private address answers:
# LOCKS_PAYKIT_REACH_CMD=ssh locks-vm docker exec locks wget -qO- -T 10 http://paykit.internal:3001/health/live
# SERVICE_PAYKIT_REACH_CMD=…   SERVICE_LOCKS_REACH_CMD=…   FIAT_PAYKIT_REACH_CMD=…

# ---- Platform commands -------------------------------------------------------------------
# Prints how many Paykit processes can serve; must print 1.
# PAYKIT_INSTANCE_COUNT_CMD=ssh paykit-vm docker ps -q --filter name=paykit-server | wc -l
# psql-compatible commands that read SQL on stdin (read-only queries only are sent):
# SERVICE_DB_SQL_CMD=psql "$SERVICE_DATABASE_URL_RO" -X -q
# PAYKIT_DB_SQL_CMD=psql "$PAYKIT_DATABASE_URL_RO" -X -q
# LOCKS_DB_SQL_CMD=psql "$LOCKS_DATABASE_URL_RO" -X -q
# <SVC>_MIGRATIONS_DIR=/path/to/checkout/migrations   # instead of fetching <SVC>_SOURCE from GitHub

# ---- Opt-in probes -----------------------------------------------------------------------
# --write-probe: an identity on the homeserver the Nexus watches (hex or base64url secret file),
# NEXUS_PROBE_SECRET_FILE=/secure/probe.secret
# or a throwaway identity signed up for the run:
# NEXUS_PROBE_HOMESERVER=<homeserver z32>
# NEXUS_PROBE_SIGNUP_TOKEN_CMD=<command printing a signup token>
# ALLOW_PRODUCTION_WRITE_PROBE=1       # required for --write-probe when MIV_ENV=production
# --browser: needs `npx playwright install chromium` once.
# --deep (staging only): named commands, each passing when it exits 0 and prints its marker.
# DEEP_PROOFS=hold_smoke
# DEEP_HOLD_SMOKE_CMD=cd /path/to/pubky-marketplace-service && python3 scripts/release/hold-smoke.py
# DEEP_HOLD_SMOKE_PASS=^HOLD_SMOKE=PASS$
# PRODUCTION_HOSTS=api.shop.example,paykit.shop.example   # a deep command naming one is refused
