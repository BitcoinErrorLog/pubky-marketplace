exports[`QrCodeSlot - Snapshots > matches snapshot for loading state 1`] = `
<div>
  <div
    class="items-center gap-2"
    data-testid="container"
  >
    <svg
      aria-hidden="true"
      class="lucide lucide-loader-circle size-8 animate-spin text-background"
      fill="none"
      height="24"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      viewBox="0 0 24 24"
      width="24"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M21 12a9 9 0 1 1-6.219-8.56"
      />
    </svg>
    <small
      class="text-background"
      data-testid="typography"
    >
      Generating...
    </small>
  </div>
</div>
`;
