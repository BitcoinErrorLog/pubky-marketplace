# =============================================================================
# Build-Time Values
# =============================================================================
# These values are intrinsic to the built artifact or local browser storage model.
# They are intentionally still NEXT_PUBLIC_* and may be baked into the bundle.

NEXT_PUBLIC_DB_NAME=franky
NEXT_PUBLIC_DB_VERSION=8
NEXT_PUBLIC_DEBUG_MODE=false

# Vibe-fork consumer mode (baked per artifact). Unset on canonical pubky.app.
# Consumer mode is active only when the bridge origin is set. The origin must be
# an exact https:// origin (e.g. https://pubky.app), or http://localhost:<port>
# when NODE_ENV is not production. NEXT_PUBLIC_VIBE_ID is the vibe slug.
# NEXT_PUBLIC_VIBE_SESSION_BRIDGE_ORIGIN=https://pubky.app
# NEXT_PUBLIC_VIBE_ID=my-vibe

# Social link-out (baked per artifact). Unset = off: the Shop serves its own
# feed, profile, post, collection and settings routes. Set to the social app's
# exact origin to 307 those routes to the same path there and switch the nav to
# Marketplace, Messages and one Pubky link (https://pubky.app for production,
# https://staging.pubky.app for staging). http://localhost:<port> is accepted
# only when NODE_ENV is not production. The Shop's own origin is rejected (it
# would redirect to itself). Redirects carry no session: each site keeps its
# own sign-in, so Shop users arrive on the social host signed out.
# NEXT_PUBLIC_SOCIAL_HOST=https://pubky.app

# =============================================================================
# Runtime Configuration (PUBKY_RUNTIME_*)
# =============================================================================
# The single config surface for everything environment-specific and
# deployer-facing. PUBLIC values (NOT secrets): supplied at CONTAINER RUNTIME
# (Ansible / Docker Compose / Kubernetes / Cloud Run). Read by the server and
# injected into `window.__PUBKY_CONFIG__`.
#
# `npm run dev` and tests read the SAME names leniently: unset values resolve
# to the staging defaults in src/libs/runtime-config/runtime-config.schema.ts,
# and partial overrides (e.g. only PUBKY_RUNTIME_NEXUS_URL in `.env.local`)
# layer over those defaults.
#
# `npm run build && npm run start` runs as NODE_ENV=production, so ALL nine
# network values below are required together (partial config fails at boot).
# Set PUBKY_RUNTIME_CONFIG_REQUIRED=true to force the same strictness under
# `npm run dev`.

# Required network tier (all nine required together in deployed/required mode)
# PUBKY_RUNTIME_NEXUS_URL=https://nexus.staging.pubky.app
# PUBKY_RUNTIME_CDN_URL=https://nexus.staging.pubky.app/static
# PUBKY_RUNTIME_HOMESERVER=ufibwbmed6jeq9k4p583go95wofakh9fwpp4k734trq79pd9u1uy
# PUBKY_RUNTIME_HOMESERVER_URL=https://homeserver.staging.pubky.app
# PUBKY_RUNTIME_HOMEGATE_URL=https://homegate.staging.pubky.app
# PUBKY_RUNTIME_DEFAULT_HTTP_RELAY=https://httprelay.staging.pubky.app/inbox
# PUBKY_RUNTIME_PKARR_RELAYS=["https://pkarr.pubky.app","https://pkarr.pubky.org"]
# PUBKY_RUNTIME_TESTNET=false
# Deploy identity ("production" | "staging"): drives the staging homeserver
# sign-in guard. Lenient dev default is "staging" (guard active in local dev);
# set "production" here to turn it off locally.
# PUBKY_RUNTIME_ENV=staging

# Local testnet example (partial overrides work in dev; unset values keep staging defaults)
# PUBKY_RUNTIME_HOMESERVER=8pinxxgqs41n4aididenw5apqp1urfmzdztr8jt4abrkdn435ewo
# PUBKY_RUNTIME_HOMESERVER_URL=http://localhost:6286
# PUBKY_RUNTIME_NEXUS_URL=http://localhost:8080
# PUBKY_RUNTIME_CDN_URL=http://localhost:8080/static
# PUBKY_RUNTIME_TESTNET=true
# PUBKY_RUNTIME_DEFAULT_HTTP_RELAY=http://localhost:15412/inbox/

# Optional Sentry tier (absent DSN disables Sentry)
# PUBKY_RUNTIME_SENTRY_DSN=https://examplekey@o0.ingest.sentry.io/0
# PUBKY_RUNTIME_SENTRY_ENVIRONMENT=production
# PUBKY_RUNTIME_SENTRY_TRACES_SAMPLE_RATE=0.1
# PUBKY_RUNTIME_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.0
# PUBKY_RUNTIME_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0

# Optional/defaulted public runtime config. Omit values to use the defaults from
# src/libs/runtime-config/runtime-config.schema.ts. Malformed provided values
# fail loudly during runtime config resolution. PUBKY_RUNTIME_MODERATION_ID is
# the exception in deployed environments: leaving it unset disables moderation
# matching and the one-time default follow. Local dev/tests retain the staging ID.
# PUBKY_RUNTIME_NOTIFICATION_POLL_INTERVAL_MS=8888
# PUBKY_RUNTIME_NOTIFICATION_POLL_ON_START=true
# PUBKY_RUNTIME_NOTIFICATION_RESPECT_PAGE_VISIBILITY=true
# PUBKY_RUNTIME_STREAM_POLL_INTERVAL_MS=8888
# PUBKY_RUNTIME_STREAM_POLL_ON_START=false
# PUBKY_RUNTIME_STREAM_RESPECT_PAGE_VISIBILITY=true
# PUBKY_RUNTIME_STREAM_FETCH_LIMIT=10
# PUBKY_RUNTIME_STREAM_CACHE_MAX_AGE_MS=300000
# PUBKY_RUNTIME_MAX_STREAM_TAGS=5
# PUBKY_RUNTIME_TTL_POST_MS=300000
# PUBKY_RUNTIME_TTL_USER_MS=600000
# PUBKY_RUNTIME_TTL_BATCH_INTERVAL_MS=5000
# PUBKY_RUNTIME_TTL_POST_MAX_BATCH_SIZE=20
# PUBKY_RUNTIME_TTL_USER_MAX_BATCH_SIZE=20
# PUBKY_RUNTIME_TTL_RETRY_DELAY_MS=60000
# Must be a raw 52-character z-base-32 Pubky when set.
# PUBKY_RUNTIME_MODERATION_ID=nto4u7kkagk5hfjk4wgueemzy61nssic811hid1ty9u81uatmqzy
# PUBKY_RUNTIME_MODERATED_TAGS=["nudity"]
# PUBKY_RUNTIME_EXCHANGE_RATE_API=https://api1.blocktank.to/api/fx/rates/btc
# Commerce fails closed by default. Set sandbox only for an explicitly local/demo deployment.
# PUBKY_RUNTIME_MARKETPLACE_URL=http://localhost:3100
# PUBKY_RUNTIME_LOCKS_URL=http://localhost:3101
# PUBKY_RUNTIME_PAYKIT_SETUP_URL=http://localhost:3102/setup
# The paykit-server fork requires `creator` on /setup; upstream pubky/paykit-server
# rejects it. Set "false" together with an upstream PUBKY_RUNTIME_PAYKIT_SETUP_URL.
# PUBKY_RUNTIME_PAYKIT_SETUP_CREATOR_PARAM=true
# Paykit Server API (default fork). "upstream" targets pubky/paykit-server and pubky/locks,
# matching the marketplace service's PAYKIT_SERVER_API=upstream: buyers pay only through a
# Paykit App Registry (Bitkit 2.6+), and seller readiness comes from the Lock Server's
# /creator/paykit/setup-status. Requires PUBKY_RUNTIME_PAYKIT_SETUP_CREATOR_PARAM=false.
# PUBKY_RUNTIME_PAYKIT_SERVER_API=fork
# PUBKY_RUNTIME_COMMERCE_ADAPTER_MODE=unavailable
# PUBKY_RUNTIME_COMMERCE_POLL_INTERVAL_MS=2000
# Single Ring approval for direct Shop sign-in (default true). Set "false" to roll
# back to the two-prompt path: awaitApproval() sign-in + empty-capability connect.
# PUBKY_RUNTIME_SINGLE_APPROVAL_SIGN_IN=true
# Pubky Passport ("Continue with Google", default true). "false" hides every Passport
# entry point: the sign-in button and the Passport purchase approval (an active Passport
# sign-in stays signed in but its purchase approval is refused). The origin defaults to
# passport.pubky.app for PUBKY_RUNTIME_ENV=production and passport.staging.pubky.app for
# staging. An override must be https:// (http://localhost only in local development).
# PUBKY_RUNTIME_PASSPORT_SIGN_IN=true
# PUBKY_RUNTIME_PASSPORT_URL=https://passport.staging.pubky.app
# USDT payments (default false). A USDT surface shows only when this is "true" AND the
# marketplace service reports usdt_payments.available on /health. "false" hides every
# USDT offer; an existing USDT order is still displayed.
# PUBKY_RUNTIME_USDT_PAYMENTS_ENABLED=false
# PUBKY_RUNTIME_PRELUDE_SDK_KEY=your_prelude_sdk_key_here
# PUBKY_RUNTIME_PRELUDE_SDK_TIMEOUT_MS=5000
# PUBKY_RUNTIME_PLAUSIBLE_DOMAIN=pubky.app
# pageview-props variant required: pageviews carry the `locale` custom property.
# PUBKY_RUNTIME_PLAUSIBLE_SCRIPT_URL=https://_analytics.synonym.to/js/script.pageview-props.js
# PUBKY_RUNTIME_PREVIEW_IMAGE=/preview.webp
# PUBKY_RUNTIME_SITE_NAME=Pubky App
# PUBKY_RUNTIME_LOCALE=en_US
# PUBKY_RUNTIME_AUTHOR=Pubky Team
# PUBKY_RUNTIME_KEYWORDS=pubky, social media, decentralized, key, pkarr, pubky core
# PUBKY_RUNTIME_TYPE=website
# PUBKY_RUNTIME_CREATOR=@getpubky
# PUBKY_RUNTIME_DEFAULT_URL=https://pubky.app
# PUBKY_RUNTIME_PUBKY_RING_URL=https://pubkyring.app/
# PUBKY_RUNTIME_PUBKY_CORE_URL=https://pubky.org
# PUBKY_RUNTIME_NEXUS_SCOUT_URL=https://nexus-scout.pubky.app
# PUBKY_RUNTIME_TWITTER_URL=https://x.com/pubky
# PUBKY_RUNTIME_TWITTER_GETPUBKY_URL=https://x.com/getpubky
# PUBKY_RUNTIME_TELEGRAM_URL=https://t.me/pubkychat
# PUBKY_RUNTIME_GITHUB_URL=https://github.com/pubky
# PUBKY_RUNTIME_EMAIL=hello@pubky.com
# PUBKY_RUNTIME_APP_STORE_URL=https://apps.apple.com/app/pubky-ring/id6739356756
# PUBKY_RUNTIME_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=to.pubky.ring&pcampaignid=web_share

# =============================================================================
# Development Only - Homeserver Admin Credentials
# =============================================================================
# For local development and E2E testing only. Do not set these in production.
# The token-generation API route is blocked in production.
# HOMESERVER_ADMIN_URL=http://localhost:6288/generate_signup_token
# HOMESERVER_ADMIN_PASSWORD=admin

# =============================================================================
# Support/Chatwoot Configuration (server-side)
# =============================================================================
# Server-side only. These are never exposed to the browser.
BASE_URL_SUPPORT=https://chatwoot.example.com
SUPPORT_API_ACCESS_TOKEN=your_token_here
SUPPORT_ACCOUNT_ID=123

# =============================================================================
# Sentry Source Map Upload (CI/build only)
# =============================================================================
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT are optional Docker build inputs
# used only for source-map upload. They are not runtime app config and are not
# needed to run the public image.
