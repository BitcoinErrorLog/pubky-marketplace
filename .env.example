# Host port mapping for the composed Locks + Paykit environment.
# All values are host-side ports only; in-container ports are fixed because the
# pinned Pubky client resolves the local testnet on fixed localhost ports.
# Defaults are chosen to avoid this machine's known occupied ports:
# 5432/5433/55432 (other Postgres), 6379/7474/7687/8001/9000/9001 (pubky-docker
# and minio stacks), and 6881/udp, 15411, 15412, 6286-6288, 3000 (a natively
# running pubky-testnet process plus a node dev server).

LOCKS_POSTGRES_PORT=55433
PAYKIT_POSTGRES_PORT=55434
LOCKS_DHT_PORT=16881
LOCKS_PKARR_RELAY_PORT=25411
LOCKS_HTTP_RELAY_PORT=25412
LOCKS_HOMESERVER_HTTP_PORT=16286
LOCKS_HOMESERVER_PUBKY_PORT=16287
LOCKS_HOMESERVER_ADMIN_PORT=16288
LOCKS_SERVER_PORT=13000
PAYKIT_SERVER_PORT=13001
LOCKS_CREATOR_DEMO_PORT=18080
LOCKS_READER_DEMO_PORT=18081

# Lock Server [paykit] section. minimum_confirmations=1 requires a confirmed,
# amount-matched output before the Locks verification task completes.
LOCKS_PAYKIT_MIN_CONFIRMATIONS=1

# 32 bytes, base64url without padding. scripts/up.sh generates this once.
PAYKIT_MASTER_KEY=
